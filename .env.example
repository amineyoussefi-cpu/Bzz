# Copy to .env and adjust. No secrets here. Every variable is optional.

# Godot release downloaded into the Docker images
GODOT_VERSION=4.7.2

# Port the Godot server listens on (inside the compose network)
GODOT_PORT=9876

# Seconds the backend waits for Godot to accept connections
GODOT_TIMEOUT=10

# Running the backend outside Docker:
#   leave GODOT_HOST empty to spawn a local Godot, or set it to connect to a running one
GODOT_HOST=
# GODOT_BIN=godot
# GODOT_PROJECT_DIR=../godot
