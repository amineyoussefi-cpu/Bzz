# Copy to .env and adjust. No secrets here. Every variable is optional.

# Godot release downloaded into the Docker images
GODOT_VERSION=4.7.2

# --- Godot display ---
# window: Godot runs on this machine in its own window (./godot/start.sh or .\godot\start.ps1), showing the simulation;
# headless: no window (tests, CI, servers). Also used when the backend spawns Godot itself (GODOT_HOST empty).
GODOT_DISPLAY=window
# Address the windowed Godot listens on. 127.0.0.1 keeps it on this machine (Docker Desktop reaches it through
# host.docker.internal). 0.0.0.0 would expose it to the network: never needed on Mac; on Windows only if the backend
# container cannot connect, and then block the port in the firewall.
GODOT_LISTEN=127.0.0.1
# How the backend container reaches Godot: host.docker.internal (window mode) or godot (headless, with the profile)
GODOT_HOST_FROM_DOCKER=host.docker.internal
# Set to headless to run Godot inside Docker instead of in a window (then GODOT_HOST_FROM_DOCKER=godot)
COMPOSE_PROFILES=

# Port Godot listens on (never published outside the machine)
GODOT_PORT=9876

# Seconds the backend waits for Godot to accept connections
GODOT_TIMEOUT=10

# World size in world units; empty = Godot's default (1000 x 700, WorldApi.DEFAULT_SIZE)
WORLD_WIDTH=
WORLD_HEIGHT=

# Simulation time and movement; empty = Godot's defaults (WorldApi.DEFAULT_CONFIG). 1 world unit = 1 m.
# Ticks in one simulated day (60 ticks = 1 real second at speed x1): 3600 = one real minute per day
DAY_TICKS=
# World units per tick for 1 m/s of flight speed (game scale that keeps flights visible; default 0.05)
FLIGHT_SPEED_FACTOR=
# Honey bee swarm flight speed in m/s (default 2.7, ~9.7 km/h)
SWARM_SPEED_MPS=
# Days a swarm can hang on its branch before nesting in the open (default 3)
SWARM_CLUSTER_DAYS=
# Seconds between two dashboard updates (positions, KPIs); default 0.25
DASHBOARD_UPDATE_INTERVAL=

# Dashboard port published on the host (http://localhost:8000). Local use only: no authentication.
DASHBOARD_PORT=8000

# Running the backend outside Docker:
#   leave GODOT_HOST empty to spawn a local Godot, or set it to connect to a running one
GODOT_HOST=
# GODOT_BIN=godot
# GODOT_PROJECT_DIR=../godot
# BZZ_HTTP_HOST=127.0.0.1   # interface the dashboard server listens on

# --- Decision service (OpenJev, runs on the host: ./decision/start.sh or .\decision\start.ps1) ---
# Model and pinned revision: every user gets the same weights. A bigger machine can use alanhuangya/OpenJev-4B
# (set its revision too).
OPENJEV_MODEL=alanhuangya/OpenJev-1.7B
OPENJEV_REVISION=7418ae8b6e3b6a6507a8a58729ae491cd1c732d9
# auto = cuda if available, else mps (Apple Silicon), else cpu
OPENJEV_DEVICE=auto
# Weights cache (downloaded once from Hugging Face, no key); relative to decision/, ignored by git
OPENJEV_CACHE_DIR=.cache
OPENJEV_HOST=127.0.0.1
OPENJEV_PORT=8009
# Windows only: CUDA build of torch (empty = cu126, or cu130 for RTX 50xx detected automatically)
TORCH_CUDA=

# Backend -> decision service. Outside Docker:
DECISION_SERVICE_URL=http://127.0.0.1:8009
# From the backend container (same principle as GODOT_HOST):
DECISION_SERVICE_URL_FROM_DOCKER=http://host.docker.internal:8009
# Every homeless bee asks for a decision every N simulation ticks (60 ticks = 1 simulated second at speed x1)
DECISION_INTERVAL_TICKS=120
# Decisions computed at the same time, candidates shown to the model, seconds before a model call times out
DECISION_CONCURRENCY=2
DECISION_MAX_CANDIDATES=12
DECISION_TIMEOUT=30
